---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatBlogDate, getBlogPosts, type BlogPost } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
const origin = Astro.site?.origin ?? 'https://southernhummers.com';
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? origin).href;
const published = post.data.pubDate;
const updated = post.data.updatedDate;
const showUpdated = updated != null && updated.toISOString().slice(0, 10) !== published.toISOString().slice(0, 10);
const faq = post.data.faq ?? [];

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: published.toISOString(),
  dateModified: (updated ?? published).toISOString(),
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  image: new URL('/images/og-card.png', Astro.site ?? origin).href,
  author: {
    '@type': 'Organization',
    name: 'Southeast Hummingbirds',
    url: origin,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Southeast Hummingbirds',
    url: origin,
  },
  ...(post.data.tags?.length ? { keywords: post.data.tags.join(', ') } : {}),
};

const schemas: object[] = [blogPosting];
if (faq.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  });
}
---

<BaseLayout
  title={`${post.data.title} | Southeast Hummingbirds`}
  description={post.data.description}
  schema={schemas}
  ogType="article"
>
  <nav aria-label="Breadcrumb" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <ol class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
      <li>
        <a href="/" class="hover:text-emerald-brand transition-colors">Home</a>
      </li>
      <li aria-hidden="true">
        <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li>
        <a href="/blog" class="hover:text-emerald-brand transition-colors">Blog</a>
      </li>
      <li aria-hidden="true">
        <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li>
        <span class="text-navy font-medium" aria-current="page">{post.data.title}</span>
      </li>
    </ol>
  </nav>

  <article class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16 md:pt-12 md:pb-24">
    <header class="max-w-3xl">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500">
        <time datetime={published.toISOString()}>
          {formatBlogDate(published)}
        </time>
        {showUpdated && updated && (
          <span>
            Updated <time datetime={updated.toISOString()}>{formatBlogDate(updated)}</time>
          </span>
        )}
        {post.data.draft && (
          <span class="rounded-full bg-ruby/10 px-2 py-0.5 text-xs font-semibold text-ruby">Draft</span>
        )}
      </div>
      <h1 class="mt-3 text-navy font-heading">{post.data.title}</h1>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">{post.data.description}</p>
      {post.data.tags && post.data.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <li class="rounded-full bg-mint px-3 py-1 text-sm font-medium text-emerald-dark">{tag}</li>
          ))}
        </ul>
      )}
    </header>

    <div class="blog-content max-w-3xl mt-10">
      <Content />
    </div>

    {faq.length > 0 && (
      <section class="max-w-3xl mt-12 border-t border-mint-dark pt-10" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="text-navy font-heading">Frequently asked questions</h2>
        <dl class="mt-6 space-y-4">
          {faq.map((item) => (
            <div class="bg-mint rounded-2xl p-6">
              <dt class="font-heading font-bold text-navy text-lg">{item.q}</dt>
              <dd class="mt-2 text-gray-600 leading-relaxed">{item.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}
  </article>
</BaseLayout>
