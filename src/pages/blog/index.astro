---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatBlogDate, getBlogPosts, postHref } from '../../lib/blog';

const posts = await getBlogPosts();
---

<BaseLayout
  title="Blog | Southeast Hummingbirds"
  description="Notes on attracting, feeding, and identifying hummingbirds in Georgia, Florida, South Carolina, and Alabama."
>
  <nav aria-label="Breadcrumb" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <ol class="flex items-center gap-2 text-sm text-gray-500">
      <li>
        <a href="/" class="hover:text-emerald-brand transition-colors">Home</a>
      </li>
      <li aria-hidden="true">
        <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li>
        <span class="text-navy font-medium" aria-current="page">Blog</span>
      </li>
    </ol>
  </nav>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 md:pt-12 md:pb-16">
    <div class="max-w-3xl">
      <h1 class="text-navy font-heading">Blog</h1>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">
        Field notes on migration, feeders, and the hummingbirds of Georgia, Florida, South Carolina, and Alabama.
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="mt-12 max-w-3xl bg-mint border border-mint-dark rounded-2xl p-8">
        <h2 class="text-xl font-heading text-navy">No posts yet</h2>
        <p class="mt-2 text-gray-600 leading-relaxed">
          New articles will be listed here, newest first.
        </p>
      </div>
    ) : (
      <div class="mt-12 grid grid-cols-1 gap-6 max-w-3xl">
        {posts.map((post) => (
          <a
            href={postHref(post.id)}
            class="group block bg-white border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-lg hover:border-emerald-200 transition-all"
          >
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500">
              <time datetime={post.data.pubDate.toISOString()}>{formatBlogDate(post.data.pubDate)}</time>
              {post.data.draft && (
                <span class="rounded-full bg-ruby/10 px-2 py-0.5 text-xs font-semibold text-ruby">Draft</span>
              )}
            </div>
            <h2 class="mt-2 text-2xl font-heading font-bold text-navy group-hover:text-emerald-brand transition-colors">
              {post.data.title}
            </h2>
            <p class="mt-2 text-gray-600 leading-relaxed">{post.data.description}</p>
            <span class="inline-flex items-center gap-1 mt-4 text-sm font-medium text-emerald-brand group-hover:text-emerald-dark transition-colors">
              Read article
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
